---
---
<div class="row">
  {% if site.enable_publication_thumbnails %}
    <div class="col col-sm-2 abbr">
      {%- if entry.abbr -%}
        {%- if site.data.venues[entry.abbr] -%}
          {% assign venue_style = null %}
          {% if site.data.venues[entry.abbr].color != blank %}
            {% assign venue_style = site.data.venues[entry.abbr].color | prepend: 'style="background-color:' | append: '"' %}
          {%- endif -%}
          <abbr
            class="badge rounded w-100"
            {% if venue_style %}
              {{ venue_style }}
            {% endif -%}
          >
            {% if site.data.venues[entry.abbr].url %}
              <a href="{{ site.data.venues[entry.abbr].url }}">{{ entry.abbr }}</a>
            {% else %}
              <div>{{- entry.abbr -}}</div>
            {% endif %}
          </abbr>
        {% else %}
          <abbr class="badge rounded w-100">{{ entry.abbr }}</abbr>
        {% endif %}
      {% endif %}
      {% if entry.preview %}
        {% if entry.preview contains '://' %}
          <img class="preview z-depth-1 rounded" src="{{ entry.preview }}">
        {% else %}
          {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
          {%
            include figure.liquid
            loading="eager"
            path=entry_path
            sizes = "200px"
            class="preview z-depth-1 rounded"
            zoomable=true
            avoid_scaling=true
            alt=entry.preview
          %}
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  <!-- Entry bib key -->
  <div id="{{ entry.key }}" class="{% if site.enable_publication_thumbnails %}col-sm-8{% else %}col-sm-12{% endif %}">
    <!-- Nature‑style reference line -->
    <div class="nature-reference">
      {% assign author_array_size = entry.author_array | size %}
      {% assign author_limit = author_array_size %}
      {% if author_array_size > 5 %}
        {% assign author_limit = 1 %}
      {% endif %}

      <!-- Build author list -->
      {% capture author_list %}
        {% for author in entry.author_array limit: author_limit %}
          {% include nature_author.liquid author=author %}
          {% if forloop.last == false %}
            {% if forloop.rindex0 == 1 %} & {% else %}, {% endif %}
          {% endif %}
        {% endfor %}
        {% if author_array_size > 5 %} et al.{% endif %}
      {% endcapture %}

      <!-- Format reference according to entry type -->
      {% if entry.type == 'article' %}
        {{ author_list | strip }} {{ entry.title }}.
        <em>{{ entry.journal }}</em>
        {% if entry.volume %}<strong>{{ entry.volume }}</strong>{% endif %}
        {% if entry.pages %}{{ entry.pages | replace: '-', '–' }}{% endif %}
        ({{ entry.year }}).

      {% elsif entry.type == 'book' %}
        {{ author_list | strip }}.
        <em>{{ entry.title }}</em>
        ({{ entry.publisher }}, {{ entry.year }}).

      {% elsif entry.type == 'inproceedings' or entry.type == 'incollection' %}
        {{ author_list | strip }}. {{ entry.title }}.
        In <em>{{ entry.booktitle }}</em>
        {% if entry.pages %}pp. {{ entry.pages | replace: '-', '–' }}{% endif %}
        ({{ entry.year }}).

      {% elsif entry.type == 'phdthesis' or entry.type == 'mastersthesis' %}
        {{ author_list | strip }}. {{ entry.title }}.
        <em>{{ entry.school }}</em>
        ({{ entry.year }}).

      {% else %}
        <!-- Fallback: use the default periodical block -->
        <div class="title">{{ entry.title }}</div>
        <div class="author">
          {% for author in entry.author_array limit: author_limit %}
            {{ author.first }} {{ author.last }}
            {% unless forloop.last %}, {% endunless %}
          {% endfor %}
        </div>
        <div class="periodical">
          {{ entrytype }}{% if entry.year %} {{ entry.year }}{% endif %}
        </div>
      {% endif %}

      <!-- DOI (optional) -->
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}">{{ entry.doi }}</a>
      {% endif %}
    </div>

    <!-- Hidden blocks (abstract, BibTeX, video, etc.) – keep them unchanged -->
    {% if entry.abstract %}
      <div class="abstract hidden">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}
    {% if entry.bibtex_show %}
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {% endif %}
    {% if entry.video and site.enable_video_embedding %}
      <div class="abstract hidden">
        <div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div>
      </div>
    {% endif %}
  </div>
</div>
